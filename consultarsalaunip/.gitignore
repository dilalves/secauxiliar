# ============================================
# MAPA DE SALAS UNIP - .gitignore
# ============================================

# IDE / Editor
.vs/
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# PHP / Composer
vendor/
composer.phar
.env
.env.local
.env.*.local

# Logs
*.log
storage/logs/
logs/

# Cache
var/cache/
bootstrap/cache/
*.cache

# Testes / Coverage
phpunit.xml
coverage/
.phpunit.result.cache

# Deploy / CI
.gitlab-ci.yml
.github/workflows/
deploy/

# Backup
*.bak
*.backup
*.orig

# Temporários
tmp/
temp/
*.tmp